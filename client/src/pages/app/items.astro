---
import AppLayout from "../../layouts/AppLayout.astro";
import { MasterCatalogList } from "../../components/features/items/MasterCatalogList";
---

<AppLayout title="Master Catalog - Cesta Tracker">
  <div class="space-y-6">
    {/* Page Header */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-carbon-black-200 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold font-display text-carbon-black-900 tracking-tight">
          Master Catalog
        </h1>
        <p class="text-xs sm:text-sm text-carbon-black-600 mt-1">
          Manage your library of recurring products, default prices, and preferred stores.
        </p>
      </div>
    </div>

    {/* Real-time searchable and filterable master catalog grid */}
    <MasterCatalogList client:load />
  </div>
</AppLayout>
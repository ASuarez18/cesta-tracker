---
import AppLayout from "../../../layouts/AppLayout.astro";
import { ListsDashboardView } from "../../../components/features/lists/ListsDashboardView";
---

<AppLayout title="Shopping Lists - Cesta Tracker">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-carbon-black-200 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold font-display text-carbon-black-900 tracking-tight">
          Shopping Lists
        </h1>
        <p class="text-xs sm:text-sm text-carbon-black-600 mt-1">
          Manage active grocery runs, monitor budgets in real-time, or review previous history.
        </p>
      </div>
    </div>

    <ListsDashboardView client:load />
  </div>
</AppLayout>
---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/ui/Navbar.astro";

interface Props {
  title?: string;
}

const { title = "Dashboard - Cesta Tracker" } = Astro.props;
---

<BaseLayout title={title}>
  <Navbar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <slot />
  </main>

  <footer class="bg-white border-t border-carbon-black-100 py-4 text-center text-xs sm:text-sm text-carbon-black-600">
    &copy; {new Date().getFullYear()} Cesta Tracker. All rights reserved.
  </footer>
</BaseLayout>
---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
}

const { title = "Dashboard - Cesta Tracker" } = Astro.props;
---

<BaseLayout title={title}>
  <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/app/dashboard" class="text-xl font-bold text-gray-900 flex items-center gap-2">
        <span>🛒</span> Cesta Tracker
      </a>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <slot />
  </main>

  <footer class="bg-white border-t border-gray-200 py-4 text-center text-sm text-gray-500">
    &copy; {new Date().getFullYear()} Cesta Tracker. Todos los derechos reservados.
  </footer>
</BaseLayout>
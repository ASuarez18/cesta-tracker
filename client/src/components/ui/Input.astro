---
interface Props {
  name: string;
  type?: "text" | "email" | "password" | "number" | "color" | "search";
  label?: string;
  placeholder?: string;
  value?: string | number;
  required?: boolean;
  error?: string;
  class?: string;
  step?: string;
}

const {
  name,
  type = "text",
  label,
  placeholder,
  value,
  required = false,
  error,
  class: className = "",
  step,
} = Astro.props;
---

<div class="w-full space-y-1.5">
  {
    label && (
      <label for={name} class="block text-xs sm:text-sm font-semibold text-carbon-black-800">
        {label} {required && <span class="text-red-600">*</span>}
      </label>
    )
  }
  <input
    type={type}
    id={name}
    name={name}
    value={value}
    placeholder={placeholder}
    required={required}
    step={step}
    class:list={[
      "w-full px-3.5 py-2.5 text-sm sm:text-base bg-white border rounded-xl text-carbon-black-900 placeholder:text-carbon-black-400 transition-all focus:outline-none focus:ring-2 focus:ring-celadon-500 focus:border-transparent",
      error ? "border-red-500 ring-1 ring-red-500" : "border-carbon-black-200",
      className,
    ]}
  />
  {error && <p class="text-xs text-red-600 font-medium">{error}</p>}
</div>
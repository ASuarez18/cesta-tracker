---
interface Props {
  colorHex?: string | null;
  variant?: "default" | "olive" | "celadon" | "frozen";
  size?: "sm" | "md";
  class?: string;
}

const {
  colorHex,
  variant = "default",
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "px-2 py-0.5 text-xs",
  md: "px-2.5 py-1 text-xs sm:text-sm font-medium",
};

const variants = {
  default: "bg-carbon-black-100 text-carbon-black-800 border border-carbon-black-200",
  olive: "bg-dusty-olive-100 text-dusty-olive-900 border border-dusty-olive-200",
  celadon: "bg-celadon-100 text-celadon-900 border border-celadon-200",
  frozen: "bg-frozen-water-100 text-frozen-water-950 border border-frozen-water-300",
};

const customStyle = colorHex
  ? `background-color: ${colorHex}15; color: ${colorHex}; border-color: ${colorHex}40;`
  : undefined;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-lg tracking-wide transition-colors",
    sizes[size],
    !colorHex && variants[variant],
    className,
  ]}
  style={customStyle}
>
  {colorHex && (
    <span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${colorHex};`} />
  )}
  <slot />
</span>
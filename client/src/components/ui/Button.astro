---
interface Props {
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary" | "outline" | "danger";
  size?: "sm" | "md" | "lg";
  fullWidth?: boolean;
  disabled?: boolean;
  class?: string;
  id?: string;
}

const {
  type = "button",
  variant = "primary",
  size = "md",
  fullWidth = false,
  disabled = false,
  class: className = "",
  id,
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center font-medium rounded-xl transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 active:scale-[0.98] disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed";

const variants = {
  primary:
    "bg-dusty-olive-700 hover:bg-dusty-olive-800 text-white focus:ring-dusty-olive-500 shadow-sm",
  secondary:
    "bg-celadon-100 hover:bg-celadon-200 text-celadon-900 focus:ring-celadon-400",
  outline:
    "border border-carbon-black-300 hover:bg-carbon-black-100 text-carbon-black-800 focus:ring-carbon-black-400",
  danger:
    "bg-red-600 hover:bg-red-700 text-white focus:ring-red-400 shadow-sm",
};

const sizes = {
  sm: "px-2.5 py-1.5 text-xs sm:text-sm",
  md: "px-4 py-2.5 text-sm",
  lg: "px-5 py-3 text-base font-semibold",
};

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  fullWidth ? "w-full" : "",
  className,
].join(" ");
---

<button type={type} class={classes} disabled={disabled} id={id}>
  <slot />
</button>
---
const pathname = Astro.url.pathname;

/**
 * @function getDesktopClass
 * @desc Gets the css class for the desktop link based on the current pathname
 * @param {string} path - Link path
 * @returns {string} - Class string
 */
const getDesktopClass = (path: string) => {
  const isActive = pathname === path || (path !== '/app/dashboard' && pathname.startsWith(path));
  
  return isActive
    ? "px-3 py-2 text-sm font-semibold text-dusty-olive-800 bg-dusty-olive-100 rounded-lg transition-colors"
    : "px-3 py-2 text-sm font-medium text-carbon-black-700 hover:text-celadon-700 hover:bg-carbon-black-50 rounded-lg transition-colors";
};

/**
 * @function getMobileClass
 * @desc Gets the css class for the mobile link based on the current pathname
 * @param {string} path - Link path
 * @returns {string} - Class string
 */
const getMobileClass = (path: string) => {
  const isActive = pathname === path || (path !== '/app/dashboard' && pathname.startsWith(path));

  return isActive
    ? "flex flex-col items-center gap-1 font-semibold px-2 py-1 text-dusty-olive-800 bg-dusty-olive-300 rounded-lg transition-colors "
    : "flex flex-col items-center gap-1 text-carbon-black-600 hover:text-celadon-700";
};
---

<header class="bg-white border-b border-carbon-black-100 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- > Branding -->
      <div class="flex items-center gap-8">
        <a href="/app/dashboard" class="flex items-center gap-2 text-xl font-bold font-display text-carbon-black-900 tracking-tight">
          <img src="/favicon.svg" alt="Cesta Tracker Logo" class="h-8 w-auto" />
          <span class="hidden sm:inline">Cesta Tracker</span>
        </a>

        <!-- > Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1">
          <a href="/app/dashboard" class={getDesktopClass("/app/dashboard")}>
            Dashboard
          </a>
          <a href="/app/lists" class={getDesktopClass("/app/lists")}>
            Lists
          </a>
          <a href="/app/items" class={getDesktopClass("/app/items")}>
            Catalog
          </a>
          <a href="/app/categories" class={getDesktopClass("/app/categories")}>
            Categories & Stores
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-3">
        <button
          id="logout-btn"
          class="px-3 py-1.5 text-sm font-medium text-carbon-black-700 hover:text-red-600 hover:bg-red-50 border border-carbon-black-200 hover:border-red-200 rounded-lg transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="hidden sm:inline">Sign Out</span>
        </button>
      </div>

    </div>

    <!-- > Mobile Navigation -->
    <nav class="md:hidden flex items-center justify-around border-t border-carbon-black-100 py-2 text-xs">
      <a href="/app/dashboard" class={getMobileClass("/app/dashboard")}>
        <span class="text-base">📊</span>
        <span>Dashboard</span>
      </a>
      <a href="/app/lists" class={getMobileClass("/app/lists")}>
        <span class="text-base">📝</span>
        <span>Lists</span>
      </a>
      <a href="/app/items" class={getMobileClass("/app/items")}>
        <span class="text-base">📦</span>
        <span>Catalog</span>
      </a>
      <a href="/app/categories" class={getMobileClass("/app/categories")}>
        <span class="text-base">🏷️</span>
        <span>Categories</span>
      </a>
    </nav>
  </div>
</header>

<script>
  import { authApi } from "../../lib/api/auth";

  const logoutBtn = document.getElementById("logout-btn");
  logoutBtn?.addEventListener("click", async () => {
    try {
      await authApi.logout();
      window.location.href = "/login";
    } catch (err) {
      console.error("Logout failed:", err);
    }
  });
</script>
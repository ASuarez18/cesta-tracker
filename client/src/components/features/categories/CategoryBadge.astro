---
interface Props {
  name: string;
  colorHex?: string | null;
  size?: "sm" | "md";
  class?: string;
}

const {
  name,
  colorHex = "#898e71",
  size = "md",
  class: className = "",
} = Astro.props;

const sizes = {
  sm: "px-2 py-0.5 text-xs font-medium",
  md: "px-2.5 py-1 text-xs sm:text-sm font-medium",
};

const badgeStyle = colorHex
  ? `background-color: ${colorHex}20; color: ${colorHex}; border-color: ${colorHex}50;`
  : "";
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-lg border transition-colors shrink-0",
    sizes[size],
    className,
  ]}
  style={badgeStyle}
>
  <span
    class="w-2 h-2 rounded-full shrink-0 shadow-xs"
    style={`background-color: ${colorHex};`}
  ></span>
  <span class="truncate">{name}</span>
</span>